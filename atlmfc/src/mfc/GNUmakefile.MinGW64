TARGETNAME=mfc
TARGETPATH=../../bin
TARGETTYPE=DYNLIB
CC = x86_64-pc-mingw32-gcc
CXX = x86_64-pc-mingw32-g++
AR = x86_64-pc-mingw32-ar
WINDRES = x86_64-pc-mingw32-windres -I../../include -DVER_LANGID=0x0409
RANLIB = x86_64-pc-mingw32-ranlib
CXXFLAGS = -O2 -I. -Wno-alloc-size-larger-than -Wno-unused-result -Wno-delete-incomplete -Wno-return-type -Wno-int-to-pointer-cast -Wno-stringop-overread -Wno-stringop-overflow -Wno-attributes -Wno-deprecated-declarations -Wno-invalid-offsetof -I ../../include -D_AFXDLL=1 -D_MFC_BLD=1 -D_MFC_DLL_BLD=1 -D_AFX_MFCS=1 -D_AFX_DEVBUILD=1 -D_AFX_NO_DAO_SUPPORT=1 -D_AFX_OLE_IMPL=1 -fpermissive
STATIC_CXXFLAGS = -O2 -Wno-alloc-size-larger-than -I. -Wno-unused-result -Wno-delete-incomplete -Wno-return-type -Wno-int-to-pointer-cast -Wno-stringop-overread -Wno-stringop-overflow -Wno-attributes -Wno-deprecated-declarations -Wno-invalid-offsetof -I ../../include -D_MFC_BLD=1 -D_AFX_DEVBUILD=1 -D_AFX_NO_DAO_SUPPORT=1 -fpermissive
CFLAGS = -O2 -I. -Wno-unused-result -Wno-return-type -Wno-int-to-pointer-cast -Wno-stringop-overread -Wno-stringop-overflow -Wno-attributes -Wno-deprecated-declarations -I ../../include -D_AFXDLL=1 -D_MFC_BLD=1 -D_MFC_DLL_BLD=1 -D_AFX_MFCS=1 -D_AFX_DEVBUILD=1 -D_AFX_NO_DAO_SUPPORT=1 -D_AFX_OLE_IMPL=1 -fpermissive
STATIC_CFLAGS = -O2 -I. -Wno-unused-result -Wno-return-type -Wno-int-to-pointer-cast -Wno-stringop-overread -Wno-stringop-overflow -Wno-attributes -Wno-deprecated-declarations -I ../../include -D_MFC_BLD=1 -D_AFX_DEVBUILD=1 -D_AFX_NO_DAO_SUPPORT=1 -fpermissive
LDFLAGS = -static-libgcc -mwindows -mdll
LIBS = -lgdi32 -ladvapi32 -lcomctl32 -lgdiplus -loleaut32 -loleacc -loledlg -lole32 -luuid -luxtheme -lhtmlhelp -lwinspool -lws2_32 -lurlmon -lwininet -limagehlp -lshlwapi -lodbc32 -limm32 -lcrypt32 -lpropsys -lmsimg32 -ldwmapi -lrpcrt4 -lwinmm -Wl,-Bstatic,-lstdc++ -Wl,-Bstatic,-lsupc++
RM = rm -f
INSTALL = install -m 755
INSTALL_DIR = /usr

