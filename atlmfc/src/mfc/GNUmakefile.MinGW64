%_res.o: %.rc
	$(WINDRES) -o $@ $<

%_wc_res.o: %.rc
	$(WINDRES) -DUNICODE=1 -D_UNICODE=1 -o $@ $<

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -o $@ -c $<

%.o: %.c
	$(CC) $(CFLAGS) -o $@ -c $<

%_wc.o: %.cpp
	$(CXX) $(CXXFLAGS) -DUNICODE=1 -D_UNICODE=1 -o $@ -c $<

%_wc.o: %.c
	$(CC) $(CFLAGS) -DUNICODE=1 -D_UNICODE=1 -o $@ -c $<

%_wc_static.o: %.cpp
	$(CXX) $(STATIC_CXXFLAGS) -DUNICODE=1 -D_UNICODE=1 -o $@ -c $<

%_wc_static.o: %.c
	$(CC) $(STATIC_CFLAGS) -DUNICODE=1 -D_UNICODE=1 -o $@ -c $<

%_static.o: %.cpp
	$(CXX) $(STATIC_CXXFLAGS) -o $@ -c $<

%_static.o: %.c
	$(CC) $(STATIC_CFLAGS) -o $@ -c $<

%_wc.o: %.s
	$(CC) -o $@ -DUNICODE=1 -D_UNICODE=1 -c $<

%_wc_static.o: %.s
	$(CC) -o $@ -DUNICODE=1 -D_UNICODE=1 -c $<

%.o: %.s
	$(CC) -o $@ -c $<

%_static.o: %.s
	$(CC) -o $@ -c $<

all: $(TARGETNAME).dll $(TARGETNAME)u.dll lib$(TARGETNAME)_static.a lib$(TARGETNAME)u_static.a

$(TARGETNAME).dll: $(OBJS)
	$(CXX) $(LDFLAGS) -Wl,--export-all-symbols -Wl,--output-def,$(TARGETNAME).def -Wl,--out-implib,lib$(TARGETNAME).a -o $@ $^ $(LIBS)

$(TARGETNAME)u.dll: $(WC_OBJS)
	$(CXX) $(LDFLAGS) -Wl,--export-all-symbols -Wl,--output-def,$(TARGETNAME)u.def -Wl,--out-implib,lib$(TARGETNAME)u.a -o $@ $^ $(LIBS)

lib$(TARGETNAME)_static.a: $(STATIC_OBJS)
	$(AR) cru $@ $^
	$(RANLIB) $@

lib$(TARGETNAME)u_static.a: $(STATIC_WC_OBJS)
	$(AR) cru $@ $^
	$(RANLIB) $@

clean:
	$(RM) $(OBJS) $(WC_OBJS) $(STATIC_WC_OBJS) $(STATIC_OBJS) lib$(TARGETNAME)_static.a lib$(TARGETNAME)u_static.a $(TARGETNAME).dll $(TARGETNAME)u.dll $(TARGETNAME).def $(TARGETNAME)u.def $(TARGETNAME)u.def lib$(TARGETNAME).a lib$(TARGETNAME)u.a

install:
	$(INSTALL) $(TARGETNAME).dll $(INSTALL_DIR)/bin/$(TARGETNAME).dll
	$(INSTALL) lib$(TARGETNAME).a $(INSTALL_DIR)/lib/lib$(TARGETNAME).a
	$(INSTALL) $(TARGETNAME)u.dll $(INSTALL_DIR)/bin/$(TARGETNAME)u.dll
	$(INSTALL) lib$(TARGETNAME)u.a $(INSTALL_DIR)/lib/lib$(TARGETNAME)u.a
	$(INSTALL) lib$(TARGETNAME)_static.a $(INSTALL_DIR)/lib/lib$(TARGETNAME)_static.a
	$(INSTALL) lib$(TARGETNAME)u_static.a $(INSTALL_DIR)/lib/lib$(TARGETNAME)u_static.a
